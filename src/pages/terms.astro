---
import Base from "../layouts/Base.astro";
import { loadSite, loadCopyHtml } from "../lib/site";
const site = loadSite();
---
<Base title={`Terms · ${site.name}`} description="This site is an introduction, not a contract. Typical ranges, not quotes." path="/terms">
  <div class="wrap prose" set:html={loadCopyHtml("terms")} />
</Base>
