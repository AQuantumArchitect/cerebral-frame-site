---
import Base from "../layouts/Base.astro";
import FrameView from "../components/FrameView.astro";
import FridaySheet from "../components/FridaySheet.astro";
import PrintButton from "../components/PrintButton.astro";
import { loadSite, loadSampleFrame } from "../lib/site";

const site = loadSite();
const frame = loadSampleFrame();
---
<Base title={`Sample Frame · ${site.name}`} description="Sample Frame of an example shop: nine things an owner wants to know, each marked current, stale, or dark. Your numbers, not these." path="/sample">
  <div class="wrap">
    <div class="actions no-print">
      <PrintButton />
    </div>
    <FrameView doc={frame} heading="p" />
    <FridaySheet />
  </div>
</Base>
