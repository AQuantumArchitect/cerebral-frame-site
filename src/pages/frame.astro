---
import Base from "../layouts/Base.astro";
import { loadSite, loadCopyHtml, telHref } from "../lib/site";

const site = loadSite();
const html = loadCopyHtml("frame");
---
<Base title={`The Frame · ${site.name}`} description="A live model of one company: a belief graph over your own records, with every number marked current, stale, or dark." path="/frame">
  <div class="wrap">
    <div class="prose" set:html={html} />
    <div class="actions no-print">
      <a class="btn" href={telHref(site.phone)}>{site.primary_cta}</a>
      <a class="btn btn-secondary" href="/work">See the three ways to hire us</a>
    </div>
  </div>
</Base>
