---
interface Props {
  label?: string;
}
const { label = "Print this page" } = Astro.props;
---
<button class="btn btn-secondary no-print" type="button" data-print>{label}</button>
<script>
  document.querySelectorAll("[data-print]").forEach((el) => {
    el.addEventListener("click", () => window.print());
  });
</script>
