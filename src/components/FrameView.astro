---
import type { FrameDoc, FrameNode } from "../lib/site";

interface Props {
  doc: FrameDoc;
  compact?: boolean;
  heading?: "h1" | "h2" | "p";
}

const { doc, compact = false, heading = "h2" } = Astro.props;
const Heading = heading;

const COMPACT_IDS = [
  "orders_week",
  "late_jobs",
  "special_order_blades",
  "vendor_backorders",
  "saturday_counter_demand",
];

const nodes: FrameNode[] = compact
  ? COMPACT_IDS.map((id) => doc.nodes.find((n) => n.id === id)).filter((n): n is FrameNode => Boolean(n))
  : doc.nodes;

const counts = { current: 0, stale: 0, dark: 0 };
for (const n of doc.nodes) counts[n.state] += 1;

const asOf = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "UTC",
  timeZoneName: "short",
}).format(new Date(doc.as_of));

const money = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });

function age(s: number | null): string {
  if (s === null) return "—";
  if (s < 3600) return `${Math.max(1, Math.round(s / 60))}m`;
  if (s < 48 * 3600) return `${Math.round(s / 3600)}h`;
  const d = s / 86400;
  return Number.isInteger(d) ? `${d}d` : `${d.toFixed(1)}d`;
}

function show(n: FrameNode): string {
  if (n.value === null) return "DARK";
  if (typeof n.value === "number") {
    if (n.unit === "USD") return `$${money.format(n.value)}`;
    return n.unit ? `${money.format(n.value)} ${n.unit}` : money.format(n.value);
  }
  return String(n.value);
}

const labelOf = (id: string) => doc.nodes.find((n) => n.id === id)?.label ?? id;
---
<section class:list={["frame-view", { compact }]} aria-label={`Frame of ${doc.subject}`}>
  <header class="frame-head">
    <div>
      <p class="frame-kicker">{doc.producer.kind}</p>
      <Heading class="frame-subject">{doc.subject}</Heading>
      <p class="frame-asof">as of {asOf}</p>
    </div>
    <p class="frame-counts">
      <span class="s-current">{counts.current} current</span>
      <span aria-hidden="true"> · </span>
      <span class="s-stale">{counts.stale} stale</span>
      <span aria-hidden="true"> · </span>
      <span class="s-dark">{counts.dark} dark</span>
    </p>
  </header>

  <ul class="frame-grid">
    {nodes.map((n) => (
      <li class:list={["tile", `is-${n.state}`]}>
        <div class="tile-top">
          <span class="tile-label">{n.label}</span>
          <span class:list={["badge", `badge-${n.state}`]}>{n.state}</span>
        </div>
        <strong class:list={["tile-value", { dark: n.value === null }]}>{show(n)}</strong>
        <p class="tile-age">
          {n.value === null ? "age —" : `age ${age(n.age_s)}`}
        </p>
        {!compact && <p class="tile-source">{n.source}</p>}
        {n.note && <p class="tile-note">{n.note}</p>}
      </li>
    ))}
  </ul>

  {!compact && doc.edges && doc.edges.length > 0 && (
    <ul class="frame-edges">
      {doc.edges.map((e) => (
        <li>
          <span>{labelOf(e.from)}</span>
          <span class="rel">{e.rel} →</span>
          <span>{labelOf(e.to)}</span>
        </li>
      ))}
    </ul>
  )}

  {!compact && <p class="frame-law">{doc.law}</p>}
</section>

<style>
  .frame-view {
    background: var(--card);
    border: 2px solid var(--ink);
    padding: 1.25rem;
    max-width: 56rem;
    margin: 1.5rem 0;
  }

  .frame-view.compact {
    padding: 1rem;
    max-width: 56rem;
  }

  .frame-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.75rem;
  }

  .frame-kicker {
    color: var(--warn);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0;
  }

  .frame-subject {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0.15rem 0 0.2rem;
  }

  .compact .frame-subject {
    font-size: 1.2rem;
  }

  .frame-asof,
  .frame-counts {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .frame-counts {
    font-weight: 600;
  }

  .s-current {
    color: var(--ok);
  }

  .s-stale {
    color: var(--warn);
  }

  .s-dark {
    color: var(--ink-soft);
  }

  .frame-grid {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
  }

  .compact .frame-grid {
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
  }

  .tile {
    border: 1px solid var(--rule);
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-height: 7rem;
    background: var(--card);
  }

  .tile.is-current {
    border-left: 4px solid var(--ok);
  }

  .tile.is-stale {
    border-left: 4px solid var(--warn);
  }

  .tile.is-dark {
    border: 1px dashed var(--ink-soft);
    color: var(--ink-soft);
    background: transparent;
  }

  .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .tile-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  .badge-current {
    color: var(--ok);
  }

  .badge-stale {
    color: var(--warn);
  }

  .badge-dark {
    color: var(--ink-soft);
    border-style: dashed;
  }

  .tile-value {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.2;
    margin-top: 0.25rem;
  }

  .tile-value.dark {
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .tile-age,
  .tile-source,
  .tile-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .tile-note {
    color: var(--ink);
    font-style: italic;
  }

  .frame-edges {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .frame-edges li {
    display: inline-flex;
    gap: 0.35rem;
  }

  .frame-edges .rel {
    color: var(--accent);
  }

  .frame-law {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
  }

  @media print {
    .frame-view {
      border-width: 1pt;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .tile {
      break-inside: avoid;
    }
  }
</style>
