---
---
<section class="video-note no-print" id="video-note">
  <h2>Leave a 20-second video</h2>
  <p>From this phone. No app. It goes to the same inbox as the form, not onto the public site.</p>
  <form class="form" data-video>
    <label>
      Name
      <input name="name" type="text" required maxlength="120" autocomplete="name" />
    </label>
    <label>
      Phone or email
      <input name="reach" type="text" required maxlength="120" autocomplete="tel" />
    </label>
    <label>
      Video
      <input name="clip" type="file" accept="video/*" capture="user" required />
    </label>
    <button class="btn" type="submit">Send the clip</button>
  </form>
  <p class="video-status" hidden></p>
</section>

<script>
  const form = document.querySelector("[data-video]") as HTMLFormElement | null;
  const status = document.querySelector(".video-status") as HTMLElement | null;
  if (form && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const file = (form.elements.namedItem("clip") as HTMLInputElement).files?.[0];
      const name = (form.elements.namedItem("name") as HTMLInputElement).value;
      const reach = (form.elements.namedItem("reach") as HTMLInputElement).value;
      if (!file) return;
      if (file.size > 12 * 1024 * 1024) {
        status.hidden = false;
        status.textContent = "Keep it under about 20 seconds (12 MB).";
        return;
      }
      status.hidden = false;
      status.textContent = "Sending…";
      try {
        const res = await fetch(`/api/note?name=${encodeURIComponent(name)}&reach=${encodeURIComponent(reach)}`, {
          method: "POST",
          headers: { "content-type": file.type || "video/mp4" },
          body: file,
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          status.textContent = "Could not send the clip. Call instead.";
          return;
        }
        form.hidden = true;
        status.textContent = "Got the clip. If you want a faster loop, call.";
      } catch {
        status.textContent = "Could not send the clip. Call instead.";
      }
    });
  }
</script>
